# 🛡️ Setu Guardian Environment Variables
# In Expo SDK 58, client-exposed variables must be prefixed with EXPO_PUBLIC_

# The FastAPI backend endpoint (Use your domain or Cloudflare tunnel URL)
EXPO_PUBLIC_API_URL=https://setu-backend.kintree.space

# Team Authentication Bearer Token
EXPO_PUBLIC_TEAM_TOKEN=setu-dev-token

# Default Family Identifier for Guardian Push Alerts
EXPO_PUBLIC_FAMILY_ID=fam_pune_9823

# Default Elder Test Device Identifier
EXPO_PUBLIC_DEVICE_ID=elder_pixel_6a_01

# Fallback Cloudflare tunnel in case custom domain is temporarily bypassed
EXPO_PUBLIC_FALLBACK_URL=https://remix-boston-took-considering.trycloudflare.com
